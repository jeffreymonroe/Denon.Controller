{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "DeviceConfig": {
    "ModelFilename": "4308ci.json",
    "ConnectionType": "Telnet",
    "Host": "192.168.1.100",
    "TelnetPort": 23,
    "Serial": {
      "PortName": "COM20",
      "BaudRate": 9600,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One"
    },
    "TimeoutRatio": "1"
  },
  "Safety": {
    "MaxVolume": 80,
    "MaxVolumeByZone": {}
  },
  "Security": {
    "AllowedOrigins": [ "http://localhost:5000" ],
    "EnableRawCommandEndpoint": false
  },
  "Kestrel": {
    "Limits": {
      "MinRequestBodyDataRate": 0,
      "MaxResponseBufferSize": 1048576
    },
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5091"
      }
    }
  }
}
