{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Limits": {
      "MinRequestBodyDataRate": 0,
      "MaxResponseBufferSize": 1048576
    },
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "DeviceConfig": {
    "RemoteWebApi": "http://localhost:5091/api/Remote/",
    "TimeoutRatio": "1"
  }

}
